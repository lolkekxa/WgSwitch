<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WgSwitch</AssemblyName>
    <RootNamespace>WgSwitch</RootNamespace>
    <Product>WgSwitch</Product>
    <!-- версия для локальной сборки; CI подставляет свою из тега (v1.2.0 → 1.2.0) -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- тесты лежат внутри папки проекта: в само приложение их не включаем -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;installer/**</DefaultItemExcludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- лёгкий рантайм: без серверного/фонового GC, без лишних локалей.
         InvariantGlobalization не включать: WPF при раскладке текста создаёт CultureInfo("en") и падает -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- DPI задаёт манифест: это WPF-приложение, WinForms здесь только ради NotifyIcon -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только для NotifyIcon: его пространства имён не тащим глобально, чтобы не конфликтовали с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WgSwitch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
