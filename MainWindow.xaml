<Window x:Class="WgSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WgSwitch"
        Title="WgSwitch" Icon="Assets/app.ico"
        Width="320" Height="572" ResizeMode="CanMinimize" WindowStartupLocation="Manual"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="{StaticResource Sans}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="RootShift" Y="12" /></Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== шапка: знак + название, справа шестерёнка / свернуть / закрыть. Тянется за всю шапку ===== -->
        <Grid Margin="16,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <!-- знак «тоннель», как у иконки приложения; цвет — состояние выбранного сервера -->
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="64" Height="64">
                            <Path x:Name="MarkArch" Data="M 15 50 L 15 32 A 17 17 0 0 1 49 32 L 49 50" StrokeThickness="7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource Muted}" />
                            <Ellipse x:Name="MarkDot" Canvas.Left="25.5" Canvas.Top="31.5" Width="13" Height="13" Fill="{StaticResource Muted}" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Canvas Width="140" Height="18" Margin="10,0,0,0" ClipToBounds="True">
                    <TextBlock x:Name="TitleText" Text="WgSwitch" FontSize="13" Foreground="{StaticResource Muted}" Canvas.Top="1">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="TitleShift" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- панель сервера: быстрые действия; видна тогда же, когда шестерёнка -->
                <Button x:Name="ToolsButton" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Tools_Click"
                        ToolTip="Сервер: SSH, SFTP, панель" Margin="0,0,2,0" Visibility="{Binding Visibility, ElementName=GearButton}">
                    <Path Style="{StaticResource Glyph}"
                          Data="M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M4 14h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2z M6 6h.01 M6 18h.01" />
                </Button>
                <Button x:Name="GearButton" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Gear_Click" ToolTip="Настройки">
                    <Path Style="{StaticResource Glyph}" RenderTransformOrigin="0.5,0.5"
                          Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z">
                        <Path.RenderTransform><RotateTransform x:Name="GearSpin" /></Path.RenderTransform>
                    </Path>
                </Button>
                <Button Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Свернуть в трей" Margin="2,0,0,0">
                    <Path Style="{StaticResource Glyph}" Data="M5 12h14" Height="2" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">

            <!-- ===================== главный экран ===================== -->
            <Grid x:Name="MainPanel" Margin="16,0,16,16">
                <Grid.RenderTransform><TranslateTransform x:Name="MainShift" /></Grid.RenderTransform>

                <!-- всё на сетке 8 px и по центру; место под сообщение зарезервировано, чтобы ошибка не двигала карточку -->
                <StackPanel VerticalAlignment="Center">

                    <!-- серверы: капсулы с точкой состояния, видны только когда серверов больше одного -->
                    <ScrollViewer x:Name="ChipsHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,16" Visibility="Collapsed" Focusable="False">
                        <StackPanel x:Name="ServerChips" Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ScrollViewer>

                    <!-- кнопка: тёмный диск; состояние — тонкое кольцо, цвет иконки и еле заметная заливка снизу -->
                    <Grid Width="168" Height="168" HorizontalAlignment="Center">
                        <Ellipse x:Name="Ripple" Width="148" Height="148" StrokeThickness="1"
                                 Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke><SolidColorBrush x:Name="RippleBrush" Color="{StaticResource GreenColor}" /></Ellipse.Stroke>
                            <Ellipse.RenderTransform><ScaleTransform x:Name="RippleScale" /></Ellipse.RenderTransform>
                        </Ellipse>

                        <Button x:Name="PowerButton" Width="148" Height="148" Cursor="Hand" Click="Power_Click"
                                FocusVisualStyle="{x:Null}" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform><ScaleTransform x:Name="PowerScale" /></Button.RenderTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="74" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Ellipse Fill="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1" />
                                <!-- оттенок состояния внутри кнопки: проявляется, пока дорисовывается кольцо -->
                                <Grid x:Name="Tint" IsHitTestVisible="False" Opacity="0">
                                    <Grid.Clip><EllipseGeometry Center="74,74" RadiusX="74" RadiusY="74" /></Grid.Clip>
                                    <Rectangle>
                                        <Rectangle.Fill><SolidColorBrush x:Name="FillBrush" Color="{StaticResource GreenColor}" /></Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <!-- кольцо состояния: при подключении само дорисовывается по кругу, при отключении стирается -->
                                <Ellipse x:Name="StateRing" Margin="0.75" StrokeThickness="1.5" IsHitTestVisible="False"
                                         StrokeDashArray="304 304" StrokeDashOffset="304" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Stroke><SolidColorBrush x:Name="RingBrush" Color="{StaticResource GreenColor}" /></Ellipse.Stroke>
                                    <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <!-- ожидание: короткая дуга, вращается с разгоном и торможением -->
                                <Ellipse x:Name="Spinner" Margin="0.75" Stroke="{StaticResource Amber}" StrokeThickness="1.5"
                                         StrokeDashArray="56 400" StrokeDashCap="Round" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerTurn" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Path Width="36" Height="36" Stretch="Uniform" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                      Data="M12 2v10 M18.4 6.6a9 9 0 1 1-12.77.04">
                                    <Path.Stroke><SolidColorBrush x:Name="IconBrush" Color="{StaticResource MutedColor}" /></Path.Stroke>
                                </Path>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- состояние: точка + крупная подпись, которая «перекатывается» при смене -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Grid Width="8" Height="8" VerticalAlignment="Center" Margin="0,2,10,0">
                            <Ellipse x:Name="DotPing" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.Fill><SolidColorBrush x:Name="DotPingBrush" Color="{StaticResource AmberColor}" /></Ellipse.Fill>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="DotPingScale" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Fill><SolidColorBrush x:Name="DotBrush" Color="{StaticResource MutedColor}" /></Ellipse.Fill>
                                <Ellipse.Effect><DropShadowEffect x:Name="DotGlow" ShadowDepth="0" BlurRadius="8" Opacity="0" Color="{StaticResource MutedColor}" /></Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StateText" Text="Выключено" FontSize="22" FontWeight="Medium" TextOptions.TextFormattingMode="Ideal">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="StateShift" /></TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="SubText" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource CopyHover}" MouseLeftButtonUp="CopyValue_MouseUp"
                               FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" Text="wg0 · 10.8.0.1" />

                    <!-- короткое сообщение: ошибка, подсказка, ссылка на установку; две строки зарезервированы -->
                    <TextBlock x:Name="MessageText" Margin="8,16,8,0" MinHeight="34" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{StaticResource Red}" Opacity="0" />

                    <!-- карточка статуса: IP уже есть под статусом, здесь только то, что меняется -->
                    <Border Margin="0,16,0,0" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,8">
                        <StackPanel>
                            <Grid Height="26">
                                <TextBlock Style="{StaticResource Label}" Text="Пинг" VerticalAlignment="Center" />
                                <TextBlock x:Name="PingValue" Style="{StaticResource Copyable}" MouseLeftButtonUp="CopyValue_MouseUp" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="26">
                                <TextBlock Style="{StaticResource Label}" Text="В сети" VerticalAlignment="Center" />
                                <TextBlock x:Name="UptimeValue" Style="{StaticResource Copyable}" MouseLeftButtonUp="CopyValue_MouseUp" VerticalAlignment="Center" />
                            </Grid>
                            <!-- подробности: настройки → «Подробно на главной» -->
                            <StackPanel x:Name="DetailRows" Visibility="Collapsed">
                                <Grid Height="26">
                                    <TextBlock Style="{StaticResource Label}" Text="Handshake" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HandshakeValue" Style="{StaticResource Copyable}" MouseLeftButtonUp="CopyValue_MouseUp" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Height="26">
                                    <TextBlock Style="{StaticResource Label}" Text="Трафик" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TrafficValue" Style="{StaticResource Copyable}" MouseLeftButtonUp="CopyValue_MouseUp" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- вышла новая версия: установленная копия обновляется сама, portable — ссылка на релиз -->
                    <Button x:Name="UpdateLink" Style="{StaticResource TextButton}" HorizontalAlignment="Center" Height="28" Margin="0,10,0,0"
                            Visibility="Collapsed" Click="UpdateLink_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock x:Name="UpdateText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== настройки (выезжают справа) ===================== -->
            <Grid x:Name="SettingsPanel" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform x:Name="SettingsShift" X="40" /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- настройки длиннее окна: прокрутка колесом, полоса — тонкая -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-6,0">
                <StackPanel Margin="0,0,6,8">
                    <!-- (01) выбранный сервер -->
                    <Grid Margin="4,8,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Сервер" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Right">
                            <Hyperlink Click="AddServer_Click" Foreground="{StaticResource Muted}" Cursor="Hand" TextDecorations="{x:Null}">+ Добавить</Hyperlink>
                            <Run Text="  " />
                            <Hyperlink x:Name="RemoveLink" Click="RemoveServer_Click" Foreground="{StaticResource Muted}" Cursor="Hand" TextDecorations="{x:Null}"><Run x:Name="RemoveText" Text="Удалить" /></Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <!-- имя = имя файла и туннеля: при смене файл переименуется -->
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Имя" VerticalAlignment="Center" />
                                <TextBox x:Name="NameBox" Style="{StaticResource InlineBox}" />
                            </Grid>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="IP для проверки" VerticalAlignment="Center" />
                                <TextBox x:Name="PingBox" Style="{StaticResource InlineBox}" />
                            </Grid>
                            <Button x:Name="ConfigRow" Style="{StaticResource RowButton}" Click="Browse_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="Конфиг" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="ConfigName" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Fg}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- режим маршрутизации этого сервера; применяется только по «Сохранить» -->
                            <CheckBox x:Name="FullTunnelSetting" Style="{StaticResource Toggle}" MinHeight="42">
                                <StackPanel>
                                    <TextBlock Text="Весь интернет через VPN" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Нужен NAT на сервере, см. SERVER.md" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="AutoConnectBox" Style="{StaticResource Toggle}" Content="Подключать при запуске" />
                        </StackPanel>
                    </Border>

                    <!-- (02) запуск -->
                    <StackPanel Orientation="Horizontal" Margin="4,16,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(02)" /><TextBlock Style="{StaticResource Label}" Text="Поведение" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartBox" Style="{StaticResource Toggle}" Content="Вместе с Windows" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                            <CheckBox x:Name="MinimizedBox" Style="{StaticResource Toggle}" Content="Сразу свёрнутым в трей" />
                            <CheckBox x:Name="NotifyBox" Style="{StaticResource Toggle}" Content="Уведомлять о потере связи" />
                            <CheckBox x:Name="ReconnectBox" Style="{StaticResource Toggle}" MinHeight="42">
                                <StackPanel>
                                    <TextBlock Text="Переподключать сам" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="после сна или смены сети — за секунды" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="ExitOffBox" Style="{StaticResource Toggle}" Content="Выключать туннели при выходе" />
                            <CheckBox x:Name="DetailsBox" Style="{StaticResource Toggle}" MinHeight="42">
                                <StackPanel>
                                    <TextBlock Text="Подробно на главной" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="ещё handshake и трафик" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="UpdatesBox" Style="{StaticResource Toggle}" MinHeight="42">
                                <StackPanel>
                                    <TextBlock Text="Проверять обновления" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="при запуске и раз в 12 часов" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- (03) резервная копия -->
                    <StackPanel Orientation="Horizontal" Margin="4,16,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(03)" /><TextBlock Style="{StaticResource Label}" Text="Резервная копия" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Button Style="{StaticResource RowButton}" Click="Export_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="Экспорт" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text="в зашифрованный файл" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource RowButton}" Click="Import_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="Импорт" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text="из файла .wgsb" VerticalAlignment="Center" Foreground="{StaticResource Faint}" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,12,4,0">
                        <Button Style="{StaticResource TextButton}" Height="28" Click="Repo_Click" ToolTip="github.com/lolkekxa/WgSwitch">
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource Mono}" FontSize="11" />
                        </Button>
                        <TextBlock Text="·" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource TextButton}" Height="28" FontSize="11" Content="Проверить обновления"
                                Click="CheckUpdates_Click" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="SettingsError" FontSize="12" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="4,0,4,12">
                        <!-- пока сообщения нет, строка не занимает места -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Button Style="{StaticResource MadeBy}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="MadeBy_Click" />
                        <Button x:Name="SaveButton" Style="{StaticResource PillButton}" Content="Сохранить" HorizontalAlignment="Right" Click="Save_Click"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===================== сервер: быстрые действия и проверка портов ===================== -->
            <Grid x:Name="ToolsPanel" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <StackPanel>
                    <Grid Margin="4,8,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Быстрые действия" />
                        </StackPanel>
                        <TextBlock x:Name="ToolsHost" Style="{StaticResource Label}" FontFamily="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Button Style="{StaticResource RowButton}" Click="Ssh_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SshDot" Width="6" Height="6" Margin="0,1,10,0" VerticalAlignment="Center" Fill="{StaticResource Faint}" />
                                        <TextBlock Style="{StaticResource ActionLabel}" Text="SSH" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="SshTarget" Style="{StaticResource Label}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="SftpRow" Style="{StaticResource RowButton}" Click="Sftp_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SftpDot" Width="6" Height="6" Margin="0,1,10,0" VerticalAlignment="Center" Fill="{StaticResource Faint}" />
                                        <TextBlock Style="{StaticResource ActionLabel}" Text="SFTP" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text="FileZilla" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="PanelRow" Style="{StaticResource RowButton}" Click="Panel_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PanelDot" Width="6" Height="6" Margin="0,1,10,0" VerticalAlignment="Center" Fill="{StaticResource Faint}" />
                                        <TextBlock Style="{StaticResource ActionLabel}" Text="Панель" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="PanelTarget" Style="{StaticResource Label}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- конфиг для телефона: свой ключ, QR для WgSwitch или WireGuard на телефоне -->
                            <Button Style="{StaticResource RowButton}" Click="Phone_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource ActionLabel}" Text="Телефон" Margin="16,0,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text="QR-код" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ToolsHint" Style="{StaticResource Hint}" Margin="4,8,4,0" />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(02)" /><TextBlock Style="{StaticResource Label}" Text="Адреса" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Пользователь SSH" VerticalAlignment="Center" />
                                <TextBox x:Name="SshUserBox" Style="{StaticResource InlineBox}" Tag="root" LostKeyboardFocus="ToolsField_LostFocus" />
                            </Grid>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Порт SSH" VerticalAlignment="Center" />
                                <TextBox x:Name="SshPortBox" Style="{StaticResource InlineBox}" Tag="22" LostKeyboardFocus="ToolsField_LostFocus" />
                            </Grid>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Панель" VerticalAlignment="Center" />
                                <TextBox x:Name="PanelBox" Style="{StaticResource InlineBox}" Width="180" Tag="http://10.8.0.1:8791" LostKeyboardFocus="ToolsField_LostFocus" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ToolsNote" Style="{StaticResource Hint}" Margin="4,8,4,0"
                               Text="Сохраняется само. SSH и SFTP идут на IP сервера внутри туннеля." />
                </StackPanel>
            </Grid>

            <!-- ===================== телефон: свой ключ и QR-код ===================== -->
            <Grid x:Name="PhonePanel" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-6,0">
                    <StackPanel Margin="0,0,6,8">
                        <StackPanel x:Name="PhoneSetup">
                            <TextBlock Style="{StaticResource Heading}" Text="Телефон" Margin="4,8,4,0" />
                            <TextBlock Style="{StaticResource Body}" Margin="4,8,4,0"
                                       Text="У телефона будет свой ключ: один и тот же конфиг на двух устройствах сразу не работает — сервер перекидывает связь между ними." />
                            <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                                <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Адрес телефона" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid Height="34">
                                    <TextBlock Style="{StaticResource Label}" Text="IP в туннеле" VerticalAlignment="Center" />
                                    <TextBox x:Name="PhoneIpBox" Style="{StaticResource InlineBox}" Tag="10.8.0.3" />
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0"
                                       Text="Следующий после этого ПК. Если он занят другим устройством — поставьте свободный." />
                        </StackPanel>

                        <StackPanel x:Name="PhoneResult" Visibility="Collapsed">
                            <!-- тёмные модули на белом: так QR читают все камеры. Сначала размыт — от случайного показа -->
                            <Grid HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Border x:Name="QrCard" Background="White" CornerRadius="16" Padding="14" Cursor="Hand"
                                        MouseLeftButtonUp="QrCard_MouseUp" ToolTip="Нажмите, чтобы скрыть">
                                    <Border.Effect><BlurEffect x:Name="QrBlur" Radius="22" KernelType="Gaussian" /></Border.Effect>
                                    <Image x:Name="PhoneQr" Width="216" Height="216" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                                </Border>
                                <Button x:Name="RevealButton" Style="{StaticResource PillButton}" Content="Показать" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Click="Reveal_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="4,10,4,0" TextAlignment="Center"
                                       Text="На телефоне: WgSwitch или WireGuard → «Сканировать QR-код»" />
                            <StackPanel Orientation="Horizontal" Margin="4,16,4,0">
                                <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Блок для сервера" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsCard}" Padding="16,12,16,4">
                                <StackPanel>
                                    <TextBlock x:Name="PhonePeerText" FontFamily="{StaticResource Mono}" FontSize="11" LineHeight="17"
                                               Foreground="{StaticResource Fg}" TextWrapping="Wrap">
                                        <TextBlock.Effect><BlurEffect x:Name="PeerBlur" Radius="8" /></TextBlock.Effect>
                                    </TextBlock>
                                    <Button x:Name="PhoneCopy" Style="{StaticResource TextButton}" Content="Скопировать" HorizontalAlignment="Right" Height="30" Click="PhoneCopy_Click" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0"
                                       Text="Допишите в /etc/wireguard/wg0.conf и примените: sudo bash -c 'wg syncconf wg0 &lt;(wg-quick strip wg0)'. Ключ телефона на ПК не сохраняется — закроете экран, и QR пропадёт." />
                            <TextBlock Style="{StaticResource Hint}" Margin="4,6,4,0" Foreground="{StaticResource Amber}"
                                       Text="Все устройства — этот ПК, телефон — должны быть в wg0.conf отдельными [Peer]. Кого там нет, команда отключит, в том числе SSH через VPN." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="PhoneError" Style="{StaticResource Body}" Foreground="{StaticResource Red}" Margin="4,0,4,12" Visibility="Collapsed" />
                    <Grid>
                        <Button Style="{StaticResource TextButton}" Content="Назад" HorizontalAlignment="Left" Click="PhoneBack_Click" />
                        <Button x:Name="PhoneGo" Style="{StaticResource PillButton}" Content="Создать QR" HorizontalAlignment="Right" Click="PhoneGo_Click" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===================== первый запуск: 1/3 — WireGuard и с чего начать ===================== -->
            <Grid x:Name="Step1" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Grid Margin="4,8,4,0">
                        <TextBlock x:Name="Step1Heading" Style="{StaticResource Heading}" Text="Настроим туннель" />
                        <Button x:Name="CancelSetupLink" Style="{StaticResource TextButton}" Content="Отмена" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Height="28" Visibility="Collapsed" Click="CancelSetup_Click" />
                    </Grid>
                    <TextBlock x:Name="Step1Intro" Style="{StaticResource Body}" Margin="4,8,4,0"
                               Text="Проверим WireGuard, подготовим конфиг и покажем, что добавить на сервер. Займёт минуту." />

                    <StackPanel Orientation="Horizontal" Margin="4,24,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="WireGuard" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="WireGuard для Windows" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="WgDot" Width="6" Height="6" Margin="0,1,8,0" Fill="{StaticResource Muted}">
                                        <Ellipse.Effect><DropShadowEffect x:Name="WgDotGlow" ShadowDepth="0" BlurRadius="8" Opacity="0.9" /></Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="WgStatusText" FontSize="12" Foreground="{StaticResource Fg}" Text="Проверяю…" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="InstallButton" Style="{StaticResource RowButton}" Click="Install_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource ActionLabel}" Text="Установить" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text="wireguard.com" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WgHint" Style="{StaticResource Hint}" Margin="4,8,4,0" Text="После установки вернитесь сюда, статус обновится сам." />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(02)" /><TextBlock Style="{StaticResource Label}" Text="С чего начнём" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Button x:Name="CreateNextButton" Style="{StaticResource RowButton}" Click="CreateNext_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource ActionLabel}" Text="Создать новый конфиг" />
                                    <Path Style="{StaticResource Chevron}" HorizontalAlignment="Right" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource RowButton}" Click="HaveConf_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource ActionLabel}" Text="У меня есть .conf" />
                                    <Path Style="{StaticResource Chevron}" HorizontalAlignment="Right" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource RowButton}" Click="RestoreFromSetup_Click">
                                <Grid>
                                    <TextBlock Style="{StaticResource ActionLabel}" Text="Восстановить из копии" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource Label}" Text=".wgsb" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0"
                               Text="Приватный ключ останется только в конфиге, а папка с ним доступна лишь администраторам." />
                </StackPanel>

                <TextBlock x:Name="Step1Error" Grid.Row="1" Style="{StaticResource Body}" Foreground="{StaticResource Red}" Margin="4,0" Visibility="Collapsed" />
            </Grid>

            <!-- ===================== 2/3 — данные сервера ===================== -->
            <Grid x:Name="Step2" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Ваш сервер" Margin="4,8,4,0" />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Сервер" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Адрес" VerticalAlignment="Center" />
                                <TextBox x:Name="EndpointBox" Style="{StaticResource InlineBox}" Width="180" Tag="IP или домен" />
                            </Grid>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Ключ" VerticalAlignment="Center" />
                                <TextBox x:Name="ServerKeyBox" Style="{StaticResource InlineBox}" Width="180" Tag="из server.pub" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0" Text="Ключ на сервере: sudo cat /etc/wireguard/server.pub. Порт по умолчанию 51820." />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(02)" /><TextBlock Style="{StaticResource Label}" Text="Этот компьютер" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="Имя" VerticalAlignment="Center" />
                                <TextBox x:Name="TunnelNameBox" Style="{StaticResource InlineBox}" Tag="wg0" />
                            </Grid>
                            <Grid Height="34">
                                <TextBlock Style="{StaticResource Label}" Text="IP в VPN" VerticalAlignment="Center" />
                                <TextBox x:Name="ClientIpBox" Style="{StaticResource InlineBox}" Tag="10.8.0.2" />
                            </Grid>
                            <CheckBox x:Name="FullTunnelBox" Style="{StaticResource Toggle}" Content="Весь интернет через VPN" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0" Text="Имя — это файл и туннель. Сервер будет .1 в той же подсети, его и пингуем." />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="Step2Error" Style="{StaticResource Body}" Foreground="{StaticResource Red}" Margin="4,0,4,12" Visibility="Collapsed" />
                    <Grid>
                        <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="4,0,0,0" Click="Back_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5 1L1 5l4 4" Width="6" Height="10" Stretch="Uniform" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Назад" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CreateButton" Style="{StaticResource PillButton}" Content="Создать" HorizontalAlignment="Right" Click="Create_Click" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===================== 3/3 — ключ клиента на сервер ===================== -->
            <Grid x:Name="Step3" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Ключ на сервер" Margin="4,8,4,0" />
                    <TextBlock Style="{StaticResource Body}" Margin="4,8,4,0"
                               Text="Конфиг готов. Допишите этот блок в /etc/wireguard/wg0.conf на сервере." />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Блок для сервера" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}" Padding="16,12,16,4">
                        <StackPanel>
                            <TextBlock x:Name="PeerText" FontFamily="{StaticResource Mono}" FontSize="11" LineHeight="17"
                                       Foreground="{StaticResource Fg}" TextWrapping="Wrap" />
                            <Button x:Name="CopyButton" Style="{StaticResource TextButton}" Content="Скопировать" HorizontalAlignment="Right" Height="30" Click="Copy_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(02)" /><TextBlock Style="{StaticResource Label}" Text="Применить без разрыва остальных" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}" Padding="16,12">
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" LineHeight="17" Foreground="{StaticResource Fg}" TextWrapping="Wrap"
                                   Text="sudo bash -c 'wg syncconf wg0 &lt;(wg-quick strip wg0)'" />
                    </Border>

                    <TextBlock Style="{StaticResource Hint}" Margin="4,8,4,0" Foreground="{StaticResource Amber}"
                               Text="Команда оставляет только пиров из файла: кого в wg0.conf нет, тот отключится, в том числе SSH через VPN." />
                    <TextBlock x:Name="ServerCidrText" Style="{StaticResource Hint}" Margin="4,12,4,0" />
                    <TextBlock x:Name="SavedPathText" Style="{StaticResource Hint}" Margin="4,4,4,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="Step3Error" Style="{StaticResource Body}" Foreground="{StaticResource Red}" Margin="4,0,4,12" Visibility="Collapsed" />
                    <Button Style="{StaticResource PillButton}" Content="Готово" HorizontalAlignment="Right" Click="Done_Click" />
                </StackPanel>
            </Grid>

            <!-- ===================== резервная копия: экспорт / импорт ===================== -->
            <Grid x:Name="BackupPanel" Margin="16,0,16,16" Visibility="Collapsed" Opacity="0">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="BackupHeading" Style="{StaticResource Heading}" Margin="4,8,4,0" />
                    <TextBlock x:Name="BackupIntro" Style="{StaticResource Body}" Margin="4,8,4,0" />

                    <StackPanel Orientation="Horizontal" Margin="4,20,4,0">
                        <TextBlock Style="{StaticResource Index}" Text="(01)" /><TextBlock Style="{StaticResource Label}" Text="Пароль от файла" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Height="38">
                                <TextBlock Style="{StaticResource Label}" Text="Пароль" VerticalAlignment="Center" />
                                <PasswordBox x:Name="BackupPass" Style="{StaticResource InlinePass}" />
                            </Grid>
                            <Grid x:Name="BackupRepeatRow" Height="38">
                                <TextBlock Style="{StaticResource Label}" Text="Ещё раз" VerticalAlignment="Center" />
                                <PasswordBox x:Name="BackupPass2" Style="{StaticResource InlinePass}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="BackupHint" Style="{StaticResource Hint}" Margin="4,8,4,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="BackupError" Style="{StaticResource Body}" Foreground="{StaticResource Red}" Margin="4,0,4,12" Visibility="Collapsed" />
                    <Grid>
                        <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="4,0,0,0" Click="BackupBack_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5 1L1 5l4 4" Width="6" Height="10" Stretch="Uniform" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Назад" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BackupGo" Style="{StaticResource PillButton}" HorizontalAlignment="Right" Click="BackupGo_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
