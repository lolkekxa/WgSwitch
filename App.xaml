<Application x:Class="WgSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WgSwitch"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ===== токены (LKXA: ink / paper / muted / faint / line; пастель → обычные цвета) ===== -->
        <Color x:Key="BgColor">#0A0A0A</Color>
        <Color x:Key="SurfaceColor">#111111</Color>
        <Color x:Key="HoverColor">#1A1A1A</Color>
        <Color x:Key="FgColor">#EDEDED</Color>
        <Color x:Key="MutedColor">#7A7A7A</Color>
        <Color x:Key="FaintColor">#3A3A3A</Color>
        <Color x:Key="LineColor">#1F1F1F</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="RedColor">#EF4444</Color>
        <Color x:Key="AmberColor">#F59E0B</Color>
        <Color x:Key="VioletColor">#8B5CF6</Color>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />

        <FontFamily x:Key="Sans">pack://application:,,,/WgSwitch;component/Assets/Fonts/#Geist</FontFamily>
        <FontFamily x:Key="Mono">pack://application:,,,/WgSwitch;component/Assets/Fonts/#Geist Mono</FontFamily>

        <!-- ease-out-expo: cubic-bezier(0.22, 1, 0.36, 1) -->
        <ExponentialEase x:Key="Expo" EasingMode="EaseOut" Exponent="6" />

        <!-- ===== иконка-кнопка в шапке: круг 28px, подсветка white/6% ===== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F1F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- контурная иконка 24×24, stroke 1.5, как в lucide -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ===== основная капсула: bg paper, текст ink, снизу «наливается» зелёным ===== -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Bg}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="18" Background="{StaticResource Fg}">
                            <Grid local:Ui.Round="18">
                                <Border x:Name="sweep" Background="{StaticResource Green}">
                                    <Border.RenderTransform><TranslateTransform Y="36" /></Border.RenderTransform>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="RenderTransform.Y" To="36" Duration="0:0:0.5" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== вторичная капсула: тонкая рамка ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- радиус с запасом: WPF ужимает его до половины высоты, капсула и при 28, и при 36 px -->
                        <Border x:Name="bd" CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource Faint}" Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Muted}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== плитка-действие: иконка + подпись, как карточки на сайте; при наведении проявляется фон ===== -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Faint}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== «Сделано в LKXA»: бейдж студии в цветах приложения; при наведении ✦ поворачивается, как на сайте ===== -->
        <Style x:Key="MadeBy" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="lkxa.ru" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#1FFFFFFF"
                                Background="{StaticResource Bg}" Padding="10,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="star" Data="M12 1Q12 12 23 12Q12 12 12 23Q12 12 1 12Q12 12 12 1Z" Width="10" Height="10"
                                      Stretch="Uniform" Fill="{StaticResource Violet}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                </Path>
                                <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource Sans}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}">
                                    <Run Text="Сделано в" /> <Run Text="LKXA" Foreground="{StaticResource Fg}" FontWeight="Medium" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#408B5CF6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="star" Storyboard.TargetProperty="RenderTransform.Angle" To="90" Duration="0:0:0.7" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="star" Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.7" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== капсула сервера на главном экране: точка состояния + имя; выбранная — с заливкой ===== -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="13" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Faint}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== поле ввода: только нижняя линия, при фокусе — фиолетовая ===== -->
        <Style x:Key="LineBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <!-- SelectionBrush ждёт кисть: Color здесь роняет приложение при первом выделении текста -->
            <Setter Property="SelectionBrush" Value="{StaticResource Violet}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,6,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Line}" />
                            <Border x:Name="focusLine" Height="1" VerticalAlignment="Bottom" Background="#8B5CF6" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- то же поле для пароля -->
        <Style x:Key="LinePass" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <!-- SelectionBrush ждёт кисть: Color здесь роняет приложение при первом выделении текста -->
            <Setter Property="SelectionBrush" Value="{StaticResource Violet}" />
            <Setter Property="SelectionOpacity" Value="0.45" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,6,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource Line}" />
                            <Border x:Name="focusLine" Height="1" VerticalAlignment="Bottom" Background="#8B5CF6" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="focusLine" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== фирменный чекбокс: скруглённый квадрат, при отметке заливается, галочка появляется с масштабом ===== -->
        <Style x:Key="BrandCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{StaticResource Faint}" Background="Transparent" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M3,8.5 L6,11.5 L13,4.5" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource Bg}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5" /></Path.RenderTransform>
                                </Path>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Green}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Green}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Expo}" />
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.5" Duration="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.5" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- подпись секции: (01) Название -->
        <Style x:Key="Index" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </Application.Resources>
</Application>
