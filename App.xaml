<Application x:Class="WgSwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WgSwitch"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ===== токены (LKXA: ink / paper / muted / faint / line; пастель → обычные цвета) ===== -->
        <Color x:Key="BgColor">#0A0A0A</Color>
        <Color x:Key="SurfaceColor">#111111</Color>
        <Color x:Key="HoverColor">#1A1A1A</Color>
        <Color x:Key="FgColor">#EDEDED</Color>
        <Color x:Key="MutedColor">#7A7A7A</Color>
        <Color x:Key="FaintColor">#3A3A3A</Color>
        <Color x:Key="LineColor">#1F1F1F</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="RedColor">#EF4444</Color>
        <Color x:Key="AmberColor">#F59E0B</Color>
        <Color x:Key="VioletColor">#8B5CF6</Color>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />

        <FontFamily x:Key="Sans">pack://application:,,,/WgSwitch;component/Assets/Fonts/#Geist</FontFamily>
        <FontFamily x:Key="Mono">pack://application:,,,/WgSwitch;component/Assets/Fonts/#Geist Mono</FontFamily>

        <!-- ease-out-expo: cubic-bezier(0.22, 1, 0.36, 1) -->
        <ExponentialEase x:Key="Expo" EasingMode="EaseOut" Exponent="6" />

        <!-- ===== иконка-кнопка в шапке: круг 28px, подсветка white/6% ===== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F1F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- контурная иконка 24×24, stroke 1.5, как в lucide -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ===== основная капсула: bg paper, текст ink, снизу «наливается» зелёным ===== -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Bg}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="18" Background="{StaticResource Fg}">
                            <Grid local:Ui.Round="18">
                                <Border x:Name="sweep" Background="#D4D4D4">
                                    <Border.RenderTransform><TranslateTransform Y="36" /></Border.RenderTransform>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="RenderTransform.Y" To="36" Duration="0:0:0.5" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== «Сделано в LKXA»: бейдж студии в цветах приложения; при наведении ✦ поворачивается, как на сайте ===== -->
        <Style x:Key="MadeBy" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="lkxa.ru" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="#1FFFFFFF"
                                Background="{StaticResource Bg}" Padding="10,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="star" Data="M12 1Q12 12 23 12Q12 12 12 23Q12 12 1 12Q12 12 12 1Z" Width="10" Height="10"
                                      Stretch="Uniform" Fill="{StaticResource Violet}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                </Path>
                                <TextBlock Margin="8,0,0,0" FontFamily="{StaticResource Sans}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}">
                                    <Run Text="Сделано в" /> <Run Text="LKXA" Foreground="{StaticResource Fg}" FontWeight="Medium" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#408B5CF6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="star" Storyboard.TargetProperty="RenderTransform.Angle" To="90" Duration="0:0:0.7" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="star" Storyboard.TargetProperty="RenderTransform.Angle" To="0" Duration="0:0:0.7" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== капсула сервера на главном экране: точка состояния + имя; выбранная — с заливкой ===== -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="13" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Faint}" />
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- подпись секции: (01) Название -->
        <Style x:Key="Index" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- значение, которое копируется кликом: рука и лёгкое затухание при наведении -->
        <Style x:Key="CopyHover" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Нажмите, чтобы скопировать" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="Copyable" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Нажмите, чтобы скопировать" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== настройки: строки как в карточке главного экрана — подпись слева, значение справа ===== -->

        <!-- тумблер: вся строка кликабельна; выключен — серый контур, включён — светлый трек и тёмная ручка -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border x:Name="track" Grid.Column="1" Width="30" Height="18" CornerRadius="9" BorderThickness="1"
                                    BorderBrush="{StaticResource Faint}" Background="Transparent" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource Muted}">
                                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Fg}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Fg}" />
                                <Setter TargetName="knob" Property="Fill" Value="{StaticResource Bg}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="RenderTransform.X" To="12" Duration="0:0:0.35" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource Expo}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- значение, которое правится прямо в строке: без рамок, при наведении и фокусе — лёгкая подложка -->
        <Style x:Key="InlineBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Fg}" />
            <Setter Property="SelectionOpacity" Value="0.25" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="6" Padding="8,4" Margin="0,0,-8,0" Background="Transparent">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Faint}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="2,0" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#141414" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#191919" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- пароль в строке: как InlineBox, но точки идут слева направо внутри поля фиксированной ширины -->
        <Style x:Key="InlinePass" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Fg}" />
            <Setter Property="SelectionOpacity" Value="0.25" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" CornerRadius="6" Padding="8,4" Margin="0,0,-8,0" Background="#111111">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#151515" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#191919" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- текстовая кнопка: «Назад», «Отмена», «Скопировать» — без рамки, при наведении светлеет -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Fg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- подпись действия в строке: светлее обычной подписи — это выбор, а не справка -->
        <Style x:Key="ActionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- строка-действие: подпись слева, значение и › справа; при наведении всё светлеет -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="row" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- карточка настроек — та же, что карточка статуса на главном экране -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,2" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- шеврон › для строк-действий -->
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Data" Value="M1 1l4 4-4 4" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource Muted}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
